# URL подписки Hynet / совместимого провайдера
SUBSCRIPTION_URL=

# Предпочтительные серверы: имена из комментария URI или IP через запятую
# Пример: США,Нидерланды,Германия  или  88.216.195.184,84.32.187.124
PREFERRED_SERVERS=США,Нидерланды,Германия,Швеция,Литва

# Какие протоколы брать из подписки (порядок = приоритет)
# На этой подписке VLESS Reality часто не поднимается, Trojan/SS — рабочие
ALLOWED_PROTOCOLS=trojan,ss,vless

# Только Reality-профили (для VLESS). Сейчас лучше false
REQUIRE_REALITY=false

# Логи sing-box: warn|info|debug
SINGBOX_LOG_LEVEL=warn

# Локальный SOCKS5 для ботов
SOCKS_HOST=0.0.0.0
SOCKS_PORT=1080

# Пути внутри контейнера
SINGBOX_BIN=sing-box
CONFIG_PATH=/data/config.json
STATE_DIR=/data

# Интервалы (секунды)
HEALTH_INTERVAL_SEC=60
PROBE_TIMEOUT_SEC=8
REFRESH_INTERVAL_SEC=1800
TCP_CONNECT_TIMEOUT_SEC=3

# Порог: если доля живых нод ниже — форс-обновление подписки
MIN_ALIVE_RATIO=0.5

# Сколько подряд fail healthcheck до failover
MAX_HEALTH_FAILURES=3

# Цель для измерения «реальности» канала
PROBE_URL=https://api.telegram.org
